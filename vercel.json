{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_PLATFORM_HOSTS": "sovereign.so,domain.sovereign.so,domains.sovereign.so",
      "VITE_REGISTRAR_LANDING_URL": "https://domain.sovereign.so/",
      "VITE_MEDIA_LANDING_URL": "https://emergency-icofcucam-3942s-projects.vercel.app/"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
