# Sovereign OS — environment template.
# Copy to .env and fill in. Never commit real keys.

# --- Supabase (shared backbone) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Layer 1: Media generation providers ---
ANTHROPIC_API_KEY=                # cinematic director / narration scripts
OPENAI_API_KEY=                   # gpt-image-1 seed frames, TTS
RUNWAY_API_KEY=                   # image_to_video render
FFMPEG_WORKER_URL=                # deployed assembly worker /assemble endpoint
WORKER_SECRET=                    # shared secret between assemble-film and the worker
BUCKET=ecosystem

# --- Layer 2: Distribution Grid (per-platform, activate as added) ---
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=
# X_BEARER_TOKEN / INSTAGRAM_* / TIKTOK_* / TELEGRAM_BOT_TOKEN / BLUESKY_* ...

# --- Layer 3: Strategic Intelligence Engine ---
# Reuses ANTHROPIC_API_KEY / OPENAI_API_KEY above for agent inference.
