{
  "name": "sovereign-os",
  "version": "0.1.0",
  "private": true,
  "description": "Sovereign AI Media & Acquisition Infrastructure — a three-layer sovereign platform seeded from the migrated Media Acquisition Ecosystem.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "layers/layer-1-media/worker"
  ],
  "scripts": {
    "build": "tsc -b packages/core",
    "typecheck": "tsc -b packages/core --noEmit",
    "dashboard:dev": "npm --workspace @sovereign/command-center run dev",
    "dashboard:build": "npm --workspace @sovereign/command-center run build",
    "worker:dev": "npm --workspace sovereign-ffmpeg-worker run start"
  },
  "engines": {
    "node": ">=20"
  }
}
