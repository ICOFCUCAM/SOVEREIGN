{
  "name": "@exit/engines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ExitOS engines \u2014 Valuation, Memorandum Generator, Strategic Buyer Discovery, Due Diligence, Exit Readiness Score, Acquisition Marketplace. Computational core consumed by exit-web (SPA) and exit-api (when it ships).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./valuation": {
      "types": "./dist/valuation/index.d.ts",
      "import": "./dist/valuation/index.js"
    },
    "./memorandum": {
      "types": "./dist/memorandum/index.d.ts",
      "import": "./dist/memorandum/index.js"
    },
    "./buyers": {
      "types": "./dist/buyers/index.d.ts",
      "import": "./dist/buyers/index.js"
    },
    "./diligence": {
      "types": "./dist/diligence/index.d.ts",
      "import": "./dist/diligence/index.js"
    },
    "./readiness": {
      "types": "./dist/readiness/index.d.ts",
      "import": "./dist/readiness/index.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace/index.d.ts",
      "import": "./dist/marketplace/index.js"
    },
    "./negotiation": {
      "types": "./dist/negotiation/index.d.ts",
      "import": "./dist/negotiation/index.js"
    },
    "./listing": {
      "types": "./dist/listing/index.d.ts",
      "import": "./dist/listing/index.js"
    },
    "./captable": {
      "types": "./dist/captable/index.d.ts",
      "import": "./dist/captable/index.js"
    },
    "./nda": {
      "types": "./dist/nda/index.d.ts",
      "import": "./dist/nda/index.js"
    },
    "./exchange": {
      "types": "./dist/exchange/index.d.ts",
      "import": "./dist/exchange/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm run build && node --test test/*.test.js",
    "refresh-buyer-history": "npm run build && node dist/scripts/refresh-buyer-history.js",
    "ingest": "npm run build && node dist/scripts/ingest/run.js",
    "ingest:smoke": "npm run build && node dist/scripts/ingest/run.js --pages 8 --no-wikidata",
    "ingest:validate": "npm run build && node dist/scripts/ingest/validate.js",
    "dna": "npm run build && node dist/scripts/dna/build.js",
    "radar": "npm run build && node dist/scripts/radar/refresh.js"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "node-html-parser": "^7.1.0",
    "typescript": "^5.5.3"
  }
}