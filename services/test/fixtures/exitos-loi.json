         "text": "Escrow or holdback"
        },
        {
         "text": "8%; the company asks no more than 5% for 12 months"
        }
       ],
       [
        {
         "text": "Indemnity cap"
        },
        {
         "text": "15%; the company asks no more than 10% of the price"
        }
       ],
       [
        {
         "text": "Exclusivity"
        },
        {
         "text": "60 days; the company asks no more than 45 days"
        }
