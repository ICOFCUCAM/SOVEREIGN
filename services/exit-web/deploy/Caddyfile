{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# a single-page app: any path that is not a file is the app's own route
	try_files {path} {path}/ /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# hashed build output caches for a year; everything else (the app's routes, media) revalidates, so a deploy shows on the next request
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@fresh not path /assets/*
	header @fresh Cache-Control "public, max-age=0, must-revalidate"
}
