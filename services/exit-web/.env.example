# ExitOS web — environment configuration.
# Copy to .env.local for local dev, or set these in your deploy/build env.
# Vite inlines VITE_* vars at BUILD time, so they must be present when you
# run `npm run build`.

# ── Supabase backend (go live) ──────────────────────────────────────
# When BOTH are set, createExitApi() selects SupabaseExitApi and the app
# persists through the live, multi-tenant backend (RLS-scoped per user).
# When unset, the app runs on the durable in-browser backend. No other
# change is needed to switch — this is the entire dependency-injection seam.
#
# These are the SOVEREIGN project's PUBLIC client credentials. The anon /
# publishable key is safe to expose in the browser; access is governed by
# Row-Level Security in supabase/migrations/0001_exitos_backend.sql.
VITE_SUPABASE_URL=https://qvjdivcdefuprnenedje.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Dc-LUmGC3gaMptf8hBHW9A_uNoY1Z63

# Going live also requires "Anonymous sign-ins" enabled in the Supabase
# project (Authentication → Sign In / Providers). The app obtains a durable
# anonymous session per browser so telemetry and listings are account-scoped
# with zero email friction; if it's disabled, the app falls back to the
# durable local backend.
