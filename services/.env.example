# Sovereign Dispatch — service configuration (Dispatch-owned, R3).
#
# This file is INTENTIONALLY separate from the repo-root .env (which configures
# the Polished Pages SPA: VITE_SUPABASE_* / Lovable). Dispatch reads only the
# variables below, so it can run against its own database and secrets with zero
# dependency on the Polished Pages project. Copy to services/.env and fill in.

# --- Database (Dispatch-owned Postgres; NOT the Polished Pages Supabase project) ---
# Application connection used by dispatch-api and dispatch-worker. Connects as the
# UNPRIVILEGED dispatch_app role so RLS is enforced (ADR-003).
PGHOST=localhost
PGPORT=5432
PGDATABASE=dispatch
DISPATCH_DB_USER=dispatch_app
# PGPASSWORD=...                      # if the cluster uses password auth
PG_POOL_MAX=8
# TLS for managed Postgres. Supabase REQUIRES SSL — set "no-verify" (TLS without
# cert verification) or "verify-full". Leave unset/"disable" for a local socket.
# PGSSLMODE=no-verify

# CORS — comma-separated allowlist of origins permitted to call the API from a
# browser (the standalone dispatch-web console is a different origin). Default "*".
# DISPATCH_CORS_ORIGIN=https://sovereign-beta-gilt.vercel.app

# Admin/owner DSN used ONLY by the migration runner (db/migrate.mjs). Needs DDL
# + CREATE ROLE. Never used by the running services.
DISPATCH_MIGRATE_URL=postgres://postgres@localhost:5432/dispatch

# --- Authentication (R2) ---
# Secret for verifying/minting Dispatch service JWTs (HS256). 32+ random bytes.
DISPATCH_TOKEN_SECRET=change-me-32-bytes-min
DISPATCH_TOKEN_ISSUER=sovereign-dispatch
DISPATCH_TOKEN_TTL_SEC=900
# Secret for verifying Supabase user JWTs (HS256). From the Supabase project's
# JWT settings. Only needed if Dispatch accepts user (UI) tokens directly.
SUPABASE_JWT_SECRET=
# Dev trust tokens ("user <tenant>:<role>") are auto-disabled when
# NODE_ENV=production. Force-disable anywhere with DISPATCH_ALLOW_DEV_TOKENS=0.
# NODE_ENV=production
# DISPATCH_GRANT_TTL_SEC=300          # single-artifact download-grant lifetime
# DISPATCH_SCRYPT_COST=16384          # service-secret scrypt N (auth latency vs cost)

# --- Classification / clearance (opt-in; off by default) ---
# When 1, reads (jobs/documents/artifacts + grant mint) are gated by
# principal.clearance >= document.classification.level within its scheme
# (uk_gov/nato/corporate). Set per-principal clearance on memberships /
# service_clients (M1). UNCLASSIFIED-equivalent docs are always open in-tenant.
# DISPATCH_ENFORCE_CLEARANCE=1

# --- Image source SSRF policy ---
# DISPATCH_ALLOW_REMOTE_IMAGES=1      # allow http(s) image src that passes IP checks
# DISPATCH_IMAGE_ALLOWLIST=assets.gov.uk,cdn.example.com  # restrict to these hosts

# --- API / worker runtime ---
PORT=8787
# WORKER_ID=worker-1
# CALLBACK_HMAC_SECRET=...            # signs outbound delivery callbacks

# --- Artifact storage ---
# Backend: fs (default; local disk) or s3 (any S3-compatible endpoint). Auto-uses
# s3 when the S3_* vars below are set. fs gives file:// URLs (dev only); s3 gives
# real SigV4 presigned, shareable, server-side-expiring download URLs.
# DISPATCH_STORAGE_BACKEND=s3
DISPATCH_STORAGE_DIR=/tmp/dispatch-artifacts
# S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com   # or https://<proj>.supabase.co/storage/v1/s3
# S3_REGION=eu-west-2
# S3_BUCKET=dispatch-artifacts
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=1               # required for Supabase Storage / MinIO

# --- PDF render hardening (Epic 10) ---
# PDF_CB_THRESHOLD=3                  # consecutive Chromium failures before the breaker opens
# PDF_CB_COOLOFF_MS=30000             # how long PDF stays paused once open
# CHROMIUM_BIN=...                    # override the headless Chromium binary path
# DISPATCH_LOG_LEVEL=info             # debug|info|warn|error
